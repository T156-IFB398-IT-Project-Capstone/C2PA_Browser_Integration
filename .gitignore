# ============================================================
# Rust
# ============================================================
rust-service/target/
rust-service/*.log
**/*.rs.bk

# Config with secrets — MUST NOT commit
rust-service/.env
rust-service/config.toml

# ============================================================
# Node / tooling (when we add bundlers later)
# ============================================================
node_modules/
.npm/
.yarn/

# ============================================================
# Extension build output (if we later add a bundler)
# ============================================================
extension/dist/

# SPIKE-001 evidence harnesses — bundled output only (embeds the WASM binary
# as base64, ~10 MB each). Source is committed; regenerate with bundle.mjs.
extension/_spike-harness/*.bundle.js
docs/phase2/spike-001-evidence/*.bundle.js

# C2PA test bench — bundled output only (embeds the WASM binary as base64,
# ~11 MB). Source (verify-entry.mjs) is committed; regenerate with
# c2pa-test-bench/build.mjs.
c2pa-test-bench/verify-bundle.js
c2pa-test-bench/verify-bundle.js.map

# ============================================================
# Test assets with real user data
# ============================================================
test-assets/private/

