# Copy to `.env` (or set these as env vars before `cargo run`).
# On first run a secret is auto-generated into config.toml and printed to stdout.

# Port the service binds to on 127.0.0.1.
C2PA_SERVICE_PORT=8901

# Log level. Use "debug" while developing, "info" in demos.
RUST_LOG=c2pa_service=debug,tower_http=info
